{
  "name": "ec2-runners",
  "private": true,
  "description": "Ephemeral GitHub Actions runners on EC2 Spot, deployed as one CloudFormation stack.",
  "type": "module",
  "scripts": {
    "check": "vp check",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:integration": "INTEGRATION=1 vp test run",
    "build": "vp pack",
    "lint:template": "uvx cfn-lint@1.57.2 template.yaml --ignore-checks W3002 --regions us-west-2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1147.0",
    "@aws-sdk/client-ec2": "3.1147.0",
    "@aws-sdk/client-lambda": "3.1147.0",
    "@aws-sdk/client-secrets-manager": "3.1147.0",
    "@aws-sdk/client-sns": "3.1147.0",
    "@aws-sdk/lib-dynamodb": "3.1147.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/request-error": "7.1.2",
    "@octokit/rest": "22.0.1",
    "@octokit/webhooks-methods": "6.0.0",
    "bottleneck": "2.19.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@octokit/openapi-webhooks-types": "12.2.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.1",
    "vite-plus": "1.3.0"
  },
  "packageManager": "bun@1.4.3"
}
