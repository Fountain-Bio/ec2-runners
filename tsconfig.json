{
  // Type-checks the Lambda source, the tests, and vite.config.ts through
  // `vp check`. Vite+ bundles and runs the .ts files directly, so TypeScript
  // never writes output.
  "compilerOptions": {
    // The Lambdas run on Node.js 24, and the tests run on Node.js under
    // Vitest. Only Node's types are loaded.
    "lib": ["ES2025"],
    "target": "ES2025",
    "types": ["node"],

    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
